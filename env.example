# Copie ce fichier en .env pour le développement local (ne jamais le commiter).

# Connexion PostgreSQL (obligatoire)
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/sigma

# Secret de session : au moins 32 caractères aléatoires (obligatoire)
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum

# Compte administrateur (facultatif ; mot de passe de 12 caractères minimum)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Mettre "production" sur Render
NODE_ENV=development
PORT=3000
